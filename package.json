{
  "name": "llama-desktop-launcher",
  "version": "0.2.6",
  "private": true,
  "license": "MIT",
  "author": "Célio <valmorbida4@gmail.com>",
  "description": "Instalador e launcher multiplataforma para llama.cpp",
  "main": "build/app/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "test": "npm run build && node --test",
    "version:check": "node scripts/check-version.js",
    "dist:win": "node scripts/build.js --no-sourcemap && electron-builder --win nsis --publish never",
    "dist:linux": "node scripts/build.js --no-sourcemap && electron-builder --linux AppImage deb rpm --publish never",
    "dist:mac": "node scripts/build.js --no-sourcemap && electron-builder --mac dmg --publish never",
    "build": "node scripts/build.js",
    "smoke:ui": "npm run build && electron scripts/smoke-ui.js",
    "smoke:ui:model": "npm run build && electron scripts/smoke-ui.js --with-model",
    "smoke:bench": "npm run build && node scripts/smoke-bench.js",
    "smoke:cli": "npm run build && node scripts/smoke-cli.js",
    "smoke:engine": "npm run build && node scripts/smoke-engine.js",
    "smoke:network": "npm run build && node scripts/smoke-network.js",
    "smoke:external:win": "npm run build && node scripts/smoke-external-cli-win.js",
    "smoke:external:linux": "npm run build && node scripts/smoke-external-cli-linux.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^38.0.0",
    "electron-builder": "24.13.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "br.celio.llamadesktoplauncher",
    "productName": "Llama Desktop Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/app/**/*",
      "!build/app/**/*.map",
      "README.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "docs/MANUAL-pt-BR.pdf",
        "to": "docs/MANUAL-pt-BR.pdf"
      },
      {
        "from": "docs/MANUAL-en.pdf",
        "to": "docs/MANUAL-en.pdf"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "maintainer": "Célio <valmorbida4@gmail.com>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "desktop": {
        "Name": "Llama Desktop Launcher"
      }
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  }
}
